      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Size": [6, 1, 6],
          "Position": [0, 1, 0],
          "Anchored": true,
          "BrickColor": "Medium stone grey"
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [70, 70, 70],
        "Brightness": 2,
        "ClockTime": 14,
        "OutdoorAmbient": [128, 128, 128]
